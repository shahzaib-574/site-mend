# Keep intake disabled until an isolated crawler worker is deployed.
SCAN_INTAKE_ENABLED=false

# Expose the live public scan journey only after intake and the isolated worker
# have passed their production rollout checks. This server-only switch cannot
# enable the API by itself; both flags must be exactly true.
PUBLIC_SCAN_UI_ENABLED=false

# Run this as a separate service only after the worker isolation checklist is
# satisfied. This switch does not enable public intake.
SCAN_WORKER_ENABLED=false
SCAN_WORKER_CONCURRENCY=2

# Use a durable Redis deployment in shared environments.
REDIS_URL=redis://127.0.0.1:6379

# A trusted reverse proxy must remove any client-supplied value and set one
# canonical IPv4 or IPv6 address in this header. Before enabling intake, also
# verify that the proxy and observability stack redact Authorization headers.
SCAN_TRUSTED_CLIENT_IP_HEADER=x-sitemend-client-ip

# Replace with at least 32 random bytes. Never commit a real secret.
SCAN_RATE_LIMIT_KEY_SECRET=replace-me

# Use a different secret from the intake key. It HMACs destination lease keys.
SCAN_WORKER_KEY_SECRET=replace-me-too

# Public-release identity. Keep these server-only: they are validated before
# canonical URLs, a sitemap, or a production-readiness signal can be emitted.
# SITE_ORIGIN must be the final custom HTTPS origin with no path, query,
# fragment, credentials, or custom port. Do not use localhost or a placeholder.
SITE_ORIGIN=
SITE_OPERATOR_NAME=
SITE_CONTACT_EMAIL=
SITE_LEGAL_JURISDICTION=
