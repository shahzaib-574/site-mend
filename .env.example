# Keep intake disabled until an isolated crawler worker is deployed.
SCAN_INTAKE_ENABLED=false

# Run this as a separate service only after the worker isolation checklist is
# satisfied. This switch does not enable public intake.
SCAN_WORKER_ENABLED=false
SCAN_WORKER_CONCURRENCY=2

# Use a durable Redis deployment in shared environments.
REDIS_URL=redis://127.0.0.1:6379

# A trusted reverse proxy must remove any client-supplied value and set one
# canonical IPv4 or IPv6 address in this header.
SCAN_TRUSTED_CLIENT_IP_HEADER=x-sitemend-client-ip

# Replace with at least 32 random bytes. Never commit a real secret.
SCAN_RATE_LIMIT_KEY_SECRET=replace-me

# Use a different secret from the intake key. It HMACs destination lease keys.
SCAN_WORKER_KEY_SECRET=replace-me-too
